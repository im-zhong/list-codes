{
  "name": "lc",
  "version": "1.2.0",
  "description": "Count code, comment, and blank lines in source trees.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun build src/cli.ts --compile --outfile dist/lc",
    "lint": "biome ci .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:compiled": "bun run build && LC_BIN=dist/lc bun test",
    "check": "bun run lint && bun run typecheck && bun test && bun run test:compiled",
    "format": "biome check --write .",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "ignore": "^5.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "^1.4.2",
    "lefthook": "^2.1.14",
    "typescript": "^7.0.2"
  }
}
